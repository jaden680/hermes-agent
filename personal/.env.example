# =============================================================================
# 업무용 프로필 시크릿 — 실제 값을 채워 ~/.hermes/profiles/work/.env 로 복사.
# 절대 깃에 커밋하지 마세요 (.gitignore가 personal/.env 를 막아둠).
# =============================================================================

# ── 모델 제공자 (provider: auto 가 아래 키 중 있는 걸로 자동 선택) ──────────────
# 셋 중 하나만 있어도 됨. Nous Portal 쓰면 `hermes login` 으로 대체 가능.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# NOUS_API_KEY=...

# ── GitHub (코드/PR/이슈 MCP) ────────────────────────────────────────────────
# repo, read:org, workflow 스코프 권장.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Jira (mcp-atlassian) ─────────────────────────────────────────────────────
# API 토큰: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=xxxxxxxx
# Confluence도 쓰면:
# CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_USERNAME=you@company.com
# CONFLUENCE_API_TOKEN=xxxxxxxx

# ── Notion ───────────────────────────────────────────────────────────────────
# 기본은 OAuth(브라우저 인증)라 키가 필요 없을 수 있음. 내부 통합 토큰을 쓸 때만:
# NOTION_TOKEN=ntn_...

# ── Slack (온콜 알림 전송 + 채팅 게이트웨이) ──────────────────────────────────
# Socket Mode 앱: bot token(xoxb-) + app token(xapp-) 필요.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 나만 봇을 쓰게 제한 (쉼표구분 Slack user id)
# SLACK_ALLOWED_USERS=U0XXXXXXX
